.PHONY: \
	build-gateway rebuild-gateway up-gateway up-d-gateway \
	build-gw-auth rebuild-gw-auth up-gw-auth up-d-gw-auth \
	build-gw-redis rebuild-gw-redis up-gw-redis up-d-gw-redis \
	build-testfe rebuild-testfe up-testfe up-d-testfe \
	build-nginx rebuild-nginx up-nginx up-d-nginx \
	up-toolbox up-d-toolbox \
	up up-d down help

.DEFAULT_GOAL := help

# ANSI colours
BOLD  := \033[1m
CYAN  := \033[36m
GREEN := \033[32m
YELLOW := \033[33m
RESET := \033[0m

# Shorthand print helpers
define log
	@printf "$(CYAN)$(BOLD)»$(RESET) $(1)\n"
endef
define ok
	@printf "$(GREEN)$(BOLD)✔$(RESET) $(1)\n"
endef

help:
	@printf "$(BOLD)Usage:$(RESET) make -f Makefile.gw <target>\n\n"
	@printf "  $(CYAN)build-<service>$(RESET)    Build image for a service\n"
	@printf "  $(CYAN)rebuild-<service>$(RESET)  Rebuild (no-cache) and restart a service\n"
	@printf "  $(CYAN)up-<service>$(RESET)       Start a service (attached)\n"
	@printf "  $(CYAN)up-d-<service>$(RESET)     Start a service (detached)\n\n"
	@printf "  $(CYAN)up$(RESET)                 Build Java services + start all (attached)\n"
	@printf "  $(CYAN)up-d$(RESET)               Build Java services + start all (detached)\n"
	@printf "  $(CYAN)down$(RESET)               Stop and remove all containers\n\n"
	@printf "  $(YELLOW)Services: gateway | gw-auth | gw-redis | testfe | nginx | toolbox$(RESET)\n"

# ── gateway-service (Quarkus/JVM — needs mvn package first) ──────────────────

build-gateway:
	$(call log, Building gateway (mvn clean package)...)
	@cd services/gateway && ./mvnw clean package -DskipTests
	$(call log, Building gateway Docker image...)
	@docker compose -f docker-compose.gw.yml build gateway-service
	$(call ok, gateway built)

rebuild-gateway:
	$(call log, Rebuilding gateway (mvn clean package)...)
	@cd services/gateway && ./mvnw clean package -DskipTests
	$(call log, Rebuilding gateway Docker image (no-cache)...)
	@docker compose -f docker-compose.gw.yml build --no-cache gateway-service
	$(call log, Restarting gateway-service...)
	@docker compose -f docker-compose.gw.yml up -d gateway-service
	$(call ok, gateway rebuilt and restarted)

up-gateway:
	$(call log, Starting gateway-service (attached)...)
	@docker compose -f docker-compose.gw.yml up gateway-service

up-d-gateway:
	$(call log, Starting gateway-service (detached)...)
	@docker compose -f docker-compose.gw.yml up -d gateway-service
	$(call ok, gateway-service started)

