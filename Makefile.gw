# ── nginx-service ─────────────────────────────────────────────────────────────

build-nginx:
	$(call log, Building nginx Docker image...)
	@docker compose -f docker-compose.gw.yml build nginx-service
	$(call ok, nginx built)

rebuild-nginx:
	$(call log, Rebuilding nginx Docker image (no-cache)...)
	@docker compose -f docker-compose.gw.yml build --no-cache nginx-service
	$(call log, Restarting nginx-service...)
	@docker compose -f docker-compose.gw.yml up -d nginx-service
	$(call ok, nginx rebuilt and restarted)

up-nginx:
	$(call log, Starting nginx-service (attached)...)
	@docker compose -f docker-compose.gw.yml up nginx-service

