# ── toolbox ────────────────────────────────────────────────────────────────────

up-toolbox:
	$(call log, Starting toolbox (attached)...)
	@docker compose -f docker-compose.gw.yml up toolbox

up-d-toolbox:
	$(call log, Starting toolbox (detached)...)
	@docker compose -f docker-compose.gw.yml up -d toolbox
	$(call ok, toolbox started)

# ── all ───────────────────────────────────────────────────────────────────────

up:
	$(call log, Building gateway (mvn package)...)
	@cd services/gateway && ./mvnw package -DskipTests
	$(call log, Building gw-auth (mvn package)...)
	@cd services/dummy/gw_auth && ./mvnw package -DskipTests
	$(call log, Starting all services...)
	@docker compose -f docker-compose.gw.yml up --build

up-d:
	$(call log, Building gateway (mvn package)...)
	@cd services/gateway && ./mvnw package -DskipTests
	$(call log, Building gw-auth (mvn package)...)
	@cd services/dummy/gw_auth && ./mvnw package -DskipTests
	$(call log, Starting all services (detached)...)
	@docker compose -f docker-compose.gw.yml up --build -d
	$(call ok, All services started)

down:
	$(call log, Stopping all services...)
	@docker compose -f docker-compose.gw.yml down
	$(call ok, All services stopped)
