# Browser-accessible (Client Side)
# Browser talks to nginx which proxies /api/* to gateway
NEXT_PUBLIC_API_URL=https://localhost

# Container-accessible (Server Side / SSR)
# SSR talks directly to gateway on internal network
GATEWAY_URL=https://gateway-service:8443
# SSR forum data fetches use internal Docker DNS
FORUM_SERVICE_URL=http://forum-service:8080

# Server port
PORT=3000

# mTLS cert paths (prod runner stage only — mounted via docker-compose)
MTLS_KEY_PATH=/certs/web.key
MTLS_CRT_PATH=/certs/web.crt
MTLS_CA_PATH=/certs/internal-ca.crt
# Trust internal CA globally for Node's native fetch
NODE_EXTRA_CA_CERTS=/certs/internal-ca.crt

# Optional runtime debug logging for services/web/server.js
# WEB_DEBUG=1
# WEB_LOG_NEXT_CACHE=1
